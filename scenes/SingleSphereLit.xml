<scene>
    <camera type="projective">
        <origin x="0.0" y="0.0" z="0.0"></origin>
        <up x="0.0" y="1.0" z="0.0"></up>
        <lookat x="0.0" y="0.0" z="-1.0"></lookat>
        <fov>60</fov>
    </camera>

    <material name="phong_purple" type="simple_phong" >
        <ka r="0.4" g="0.0" b="0.4"></ka>
        <kd r="0.8" g="0.0" b="0.8"></kd>
        <ks r="1.0" g="1.0" b="1.0"></ks>
        <power>1.3</power>
    </material>

    <antialiasing type="jittered" samples="16"></antialiasing>

    <transformation name="t1">
        <scale x="1.0" y="1.0" z="1.0"></scale>
        <translation z="-3.0"></translation>
    </transformation>

    <shape type="sphere" material="phong_purple" transformation="t1"></shape>

    <light type="point" intensity="1.0">
        <position x="0.0" y="0.0" z="10.0"></position>
        <color r="1.0" g="1.0" b="1.0"></color>
        <intensity>1.0</intensity>
    </light>
    <light type="ambient">
        <intensity>1.0</intensity>
    </light>
</scene>